---
import { site } from '../site.config';
---

<form class="form" id="contact-form" method="POST" action="https://api.web3forms.com/submit">
  <input type="hidden" name="access_key" value={site.formAccessKey} />
  <input type="hidden" name="subject" value="New message from jandali-work" />
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

  <div class="row">
    <label for="name">Your name</label>
    <input id="name" name="name" type="text" required autocomplete="name" />
  </div>

  <div class="row">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required autocomplete="email" />
  </div>

  <div class="row">
    <label for="about">What is this about</label>
    <select id="about" name="about">
      <option>A role</option>
      <option>Freelance or contract work</option>
      <option>Event photography</option>
      <option>Something else</option>
    </select>
  </div>

  <div class="row">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <button class="btn" type="submit">Send message</button>
  <p class="status" id="form-status" role="status" aria-live="polite"></p>
</form>

<style>
  .form {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .row {
    display: grid;
    gap: 0.45rem;
  }

  label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  input,
  select,
  textarea {
    font-family: var(--body);
    font-size: 1rem;
    color: var(--paper);
    background: var(--raise);
    border: 1px solid var(--line);
    padding: 0.8rem 0.9rem;
    border-radius: 0;
    width: 100%;
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--lime);
    outline: none;
  }

  .btn {
    justify-self: start;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .status {
    font-family: var(--mono);
    font-size: 0.8rem;
    margin: 0;
    min-height: 1.2em;
  }

  .status[data-state='error'] {
    color: #ff6a4d;
  }

  .status[data-state='ok'] {
    color: var(--lime);
  }
</style>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    const key = form.querySelector('input[name="access_key"]').value;

    if (!key) {
      e.preventDefault();
      status.dataset.state = 'error';
      status.textContent = 'The form is not connected yet. Add your Web3Forms access key in src/site.config.ts.';
      return;
    }

    e.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    status.dataset.state = '';
    status.textContent = 'Sending';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
      });
      if (!res.ok) throw new Error('Request failed');
      form.reset();
      status.dataset.state = 'ok';
      status.textContent = 'Sent. You will get a reply within two business days.';
    } catch {
      status.dataset.state = 'error';
      status.textContent = 'That did not send. Email abdul.jndli@gmail.com instead.';
    } finally {
      button.disabled = false;
    }
  });
</script>
