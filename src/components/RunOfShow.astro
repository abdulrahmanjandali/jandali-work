---
import type { Role } from '../data/roles';

const { entries, compact = false } = Astro.props as { entries: Role[]; compact?: boolean };

// City codes. Real airport codes for the two cities the whole record moves between.
function code(city: string) {
  if (city.includes('Ottawa')) return 'YOW';
  if (city.includes('Doha')) return 'DOH';
  return city.slice(0, 3).toUpperCase();
}
---

<ol class="ros">
  {
    entries.map((role, i) => (
      <li class="ros__row reveal">
        <div class="ros__rail">
          <span class="ros__no">{String(i + 1).padStart(2, '0')}</span>
          <span class="ros__mark" aria-hidden="true" />
        </div>

        <div class="ros__body">
          <div class="ros__meta">
            <span class="cue">
              {role.start} &ndash; {role.end}
            </span>
            <span class="cue ros__code">{code(role.city)}</span>
            <span class="cue">{role.commitment}</span>
            {role.remoteNote && <span class="cue ros__note">{role.remoteNote}</span>}
          </div>

          <h3 class="ros__title">{role.title}</h3>
          <p class="ros__org">
            {role.link ? <a href={role.link}>{role.org}</a> : role.org}
          </p>

          {!compact && (
            <ul class="ros__points">
              {role.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .ros {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ros__row {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: 0 1.5rem;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .ros__row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .ros__rail {
    position: relative;
    display: flex;
    align-items: start;
    gap: 0.75rem;
  }

  .ros__no {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    padding-top: 0.35rem;
  }

  .ros__mark {
    width: 1px;
    align-self: stretch;
    background: var(--line);
    position: relative;
    margin-left: auto;
  }

  .ros__mark::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    left: -0.2rem;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--lime);
  }

  .ros__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-bottom: 0.85rem;
  }

  .ros__code {
    color: var(--lime);
  }

  .ros__note {
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .ros__title {
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    font-variation-settings: 'wdth' 90;
  }

  .ros__org {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.5rem 0 0;
  }

  .ros__org a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .ros__org a:hover {
    color: var(--lime);
    border-bottom-color: var(--lime);
  }

  .ros__points {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
    max-width: 60ch;
  }

  .ros__points li {
    position: relative;
    padding-left: 1.1rem;
    color: color-mix(in srgb, var(--paper) 86%, transparent);
  }

  .ros__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.35rem;
    height: 1px;
    background: var(--lime);
  }

  @media (max-width: 640px) {
    .ros__row {
      grid-template-columns: 2.5rem 1fr;
      gap: 0 1rem;
    }
    .ros__mark {
      display: none;
    }
  }
</style>
